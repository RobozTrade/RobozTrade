{
  "name": "roboz-trade",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:backend",
    "dev:frontend": "bun --cwd apps/frontend dev",
    "dev:backend": "bun --cwd apps/backend dev",
    "build": "bun run --recursive build",
    "build:frontend": "bun --cwd apps/frontend build",
    "build:backend": "bun --cwd apps/backend build",
    "db:generate": "bun --cwd apps/backend db:generate",
    "db:migrate": "bunx wrangler d1 migrations apply roboz-trade --config apps/backend/wrangler.toml",
    "deploy:backend": "bun --cwd apps/backend deploy",
    "deploy:frontend": "bun run build:frontend",
    "type-check": "bun run --recursive type-check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  }
}
