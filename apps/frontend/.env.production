# Production Environment Variables
# For unified deployment, use empty strings for same-origin requests

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API URL - Empty for same-origin (frontend and backend on same Worker)
VITE_API_URL=

# WebSocket URL - Empty for same-origin
VITE_WS_URL=

# ============================================================================
# WALLETCONNECT CONFIGURATION
# ============================================================================

# WalletConnect Project ID (from https://cloud.reown.com/)
# Use the same project ID as development or create a separate production project
VITE_WALLETCONNECT_PROJECT_ID=e9eee19e35b12b88aa0eff7f0ddaef7e

# ============================================================================
# APP METADATA
# ============================================================================

# Application Name
VITE_APP_NAME=RobozTrade

# Application Description
VITE_APP_DESCRIPTION=AI-Powered Trading Bot Platform

# Application URL - Update with your production domain
VITE_APP_URL=https://roboz-trade.workers.dev

# Application Icon URL - Update with your production domain
VITE_APP_ICON=https://roboz-trade.workers.dev/icon.png

# ============================================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================================

# USDT Contract Address on BSC (same for all environments)
VITE_USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Payment Recipient Address (your wallet address)
# IMPORTANT: Replace with your actual BSC wallet address
VITE_PAYMENT_RECIPIENT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb1

# Required Payment Amount in USDT
VITE_REQUIRED_PAYMENT_AMOUNT=10

