# Frontend Environment Variables Example
# Copy this file to .env.development for local development
# For production, use .env.production

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API Base URL
# Development: Point to local backend
# Production: Leave empty for same-origin requests (unified deployment)
VITE_API_URL=http://localhost:8787/api

# WebSocket URL
# Development: Point to local backend WebSocket
# Production: Leave empty for same-origin requests (unified deployment)
VITE_WS_URL=ws://localhost:8787/ws

# ============================================================================
# WALLETCONNECT CONFIGURATION
# ============================================================================

# WalletConnect Project ID (from https://cloud.reown.com/)
# Get your own project ID at: https://cloud.reown.com/
VITE_WALLETCONNECT_PROJECT_ID=e9eee19e35b12b88aa0eff7f0ddaef7e

# ============================================================================
# APP METADATA
# ============================================================================

# Application Name
VITE_APP_NAME=RobozTrade

# Application Description
VITE_APP_DESCRIPTION=AI-Powered Trading Bot Platform

# Application URL - Update with your production domain
VITE_APP_URL=https://roboz.trade

# Application Icon URL - Update with your production domain
VITE_APP_ICON=https://roboz.trade/icon.png

# ============================================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================================

# USDT Contract Address on BSC
VITE_USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Payment Recipient Address (your wallet address)
# Replace with your actual BSC wallet address
VITE_PAYMENT_RECIPIENT_ADDRESS=0xB8b687E16BD6Ce3E37e6f9fd534542F75009c86B

# Required Payment Amount in USDT
VITE_REQUIRED_PAYMENT_AMOUNT=10

