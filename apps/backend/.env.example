# Backend Environment Variables Example
# Copy this file to .env for local development
# For production, use `wrangler secret put VARIABLE_NAME` for secrets

# ============================================================================
# SECRETS (use `wrangler secret put` in production)
# ============================================================================

# JWT Secret - Used for signing authentication tokens
# Generate with: openssl rand -base64 32
# REQUIRED
JWT_SECRET=your-jwt-secret-change-in-production

# Encryption Key - Used for encrypting API keys in database
# Generate with: openssl rand -base64 32
# REQUIRED - MUST be different from JWT_SECRET
ENCRYPTION_KEY=your-encryption-key-change-in-production

# ============================================================================
# PUBLIC CONFIGURATION (can be in wrangler.toml [vars])
# ============================================================================

# Aster DEX API Base URL
# Default: https://fapi.asterdex.com
ASTER_API_BASE_URL=https://fapi.asterdex.com

# CORS Allowed Origins (comma-separated list)
# Default: http://localhost:5173,http://localhost:3000,https://roboz-trade.workers.dev
# Add your custom domain here when configured
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://roboz-trade.workers.dev

# ============================================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================================

# BSC RPC URL
# Default: https://bsc-dataseed1.binance.org
BSC_RPC_URL=https://bsc-dataseed1.binance.org

# USDT Contract Address on BSC
# Default: 0x55d398326f99059fF775485246999027B3197955
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Payment Recipient Address (your wallet address)
# REQUIRED - Replace with your actual BSC wallet address
PAYMENT_RECIPIENT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb1

# Required Payment Amount in USDT
# Default: 10
REQUIRED_PAYMENT_AMOUNT=10

# Minimum Confirmations for Payment
# Default: 3
MIN_CONFIRMATIONS=3

# ============================================================================
# CRYPTO CONFIGURATION
# ============================================================================

# PBKDF2 Iterations for encryption/decryption
# Higher = more secure but slower
# Default: 100000
PBKDF2_ITERATIONS=100000

# ============================================================================
# RATE LIMITING (optional)
# ============================================================================

# Rate limit window in milliseconds
# Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window
# Default: 100
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# CLOUDFLARE BINDINGS (configured in wrangler.toml, not in .env)
# ============================================================================
# - DB (D1 Database binding)
# - MARKET_WS (Durable Object binding)
# - ASSETS (Static assets binding)

